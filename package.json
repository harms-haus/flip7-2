{
  "name": "bigdeckenergy-monorepo",
  "version": "1.0.0",
  "description": "BigDeckEnergy monorepo containing the core library and CLI tool",
  "private": true,
  "workspaces": [
    "big-deck-energy",
    "deck-in-a-box"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:lib": "npm run build --workspace=big-deck-energy",
    "build:cli": "npm run build --workspace=deck-in-a-box",
    "test": "npm run tests --workspaces",
    "test:lib": "npm run tests --workspace=big-deck-energy",
    "test:cli": "npm run tests --workspace=deck-in-a-box",
    "lint": "npm run lint --workspaces",
    "format": "npm run format --workspaces",
    "clean": "npm run clean --workspaces",
    "dev:lib": "npm run dev --workspace=big-deck-energy",
    "dev:cli": "npm run dev --workspace=deck-in-a-box"
  },
  "keywords": [
    "card-games",
    "typescript",
    "cli",
    "library",
    "monorepo"
  ],
  "author": "BigDeckEnergy Contributors",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  }
}