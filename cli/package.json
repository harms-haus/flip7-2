{
  "name": "deck-in-a-box",
  "version": "1.0.0",
  "description": "A command-line interface for playing BigDeckEnergy card games in the terminal",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "deck-in-a-box": "./dist/cli.js",
    "dib": "./dist/cli.js"
  },
  "files": [
    "dist",
    "games"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "tests": "jest",
    "tests:watch": "jest --watch",
    "tests:coverage": "jest --coverage",
    "prepublishOnly": "npm run build && npm run tests",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "cli",
    "terminal",
    "tui",
    "card-games",
    "big-deck-energy",
    "interactive",
    "console-games"
  ],
  "author": "BigDeckEnergy Contributors",
  "license": "MIT",
  "dependencies": {
    "big-deck-energy": "file:../",
    "chalk": "^5.3.0",
    "commander": "^11.0.0",
    "ink": "^4.4.1",
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^14.3.1",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "ink-testing-library": "^4.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "react-test-renderer": "^19.2.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  }
}
